
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_NAME = 'flask-devops-app'
        DOCKERHUB_REPO = 'shivix/flask-devops-app'
        CONTAINER_NAME = 'flask-demo'
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
                echo 'GitHub repository checked out successfully.'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh '''
                        set -e

                        docker build \
                          -t "${DOCKERHUB_REPO}:build-${BUILD_NUMBER}" \
                          -t "${IMAGE_NAME}:latest" \
                          .
                    '''
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    set -e

                    docker image inspect \
                      "${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e

                        printf '%s' "$DOCKER_PASS" |
                          docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                    set -e

                    docker push \
                      "${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"
                '''
            }
        }

        stage('Deploy Flask on EC2') {
            steps {
                sh '''
                    set -e

                    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

                    docker run -d \
                      --name "$CONTAINER_NAME" \
                      --restart unless-stopped \
                      -p 5000:5000 \
                      "${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -e

                    echo "Checking Flask container..."

                    docker ps \
                      --filter "name=^/${CONTAINER_NAME}$"

                    echo "Waiting for application startup..."

                    sleep 5

                    docker inspect \
                      -f '{{.State.Running}}' "$CONTAINER_NAME" |
                      grep -qx true

                    echo "Flask container is running."
                '''
            }
        }
    }

    post {
        success {
            echo "CI/CD pipeline completed successfully."
            echo "Image: ${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }

        always {
            sh 'docker logout || true'
        }
    }
}
