
pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        DOCKERHUB_REPO = 'shivix/flask-devops-app'
        K8S_NAMESPACE = 'flask-cicd'
        K8S_DEPLOYMENT = 'flask-app'
    }

    stages {
        stage('Build Docker Image') {
            agent {
                label 'docker-build'
            }

            steps {
                checkout scm

                dir('app') {
                    sh '''
                        set -e
                        docker build \
                          -t "${DOCKERHUB_REPO}:build-${BUILD_NUMBER}" \
                          .
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            agent {
                label 'docker-build'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e
                        printf '%s' "$DOCKER_PASS" | \
                          docker login -u "$DOCKER_USER" --password-stdin

                        docker push \
                          "${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"
                    '''
                }
            }

            post {
                always {
                    sh 'docker logout || true'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            agent {
                label 'k8s-deploy'
            }

            steps {
                sh '''
                    set -e

                    test "$(kubectl config current-context)" = "kind-cicd-lab"

                    kubectl set image deployment/flask-app \
                      flask-app="${DOCKERHUB_REPO}:build-${BUILD_NUMBER}" \
                      -n "${K8S_NAMESPACE}"

                    kubectl rollout status deployment/flask-app \
                      -n "${K8S_NAMESPACE}" \
                      --timeout=180s
                '''
            }
        }

        stage('Verify Deployment') {
            agent {
                label 'k8s-deploy'
            }

            steps {
                sh '''
                    set -e

                    EXPECTED="${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"

                    ACTUAL=$(kubectl get deployment flask-app \
                      -n "${K8S_NAMESPACE}" \
                      -o jsonpath='{.spec.template.spec.containers[0].image}')

                    test "$ACTUAL" = "$EXPECTED"

                    kubectl wait \
                      --for=condition=available \
                      deployment/flask-app \
                      -n "${K8S_NAMESPACE}" \
                      --timeout=120s

                    kubectl get pods -n "${K8S_NAMESPACE}"
                '''
            }
        }
    }

    post {
        success {
            echo "Successfully deployed ${DOCKERHUB_REPO}:build-${BUILD_NUMBER}"
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
